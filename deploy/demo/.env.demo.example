# 演示实例环境变量（复制成 .env 使用；与生产实例的 .env 完全独立）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
WEB_PORT=8880

# 建议给演示实例单独开两个桶：公开桶 + 私密空间桶
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=a-picture-demo
R2_PRIVATE_BUCKET_NAME=a-picture-demo-space
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# 腾讯云 COS（可选，file.storage.type 改成 cos 时才用）
COS_HOST=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_NAME=
COS_REGION=ap-shanghai

# 阿里云百炼（仅 AI 扩图需要，留空则该功能报错）
ALIYUN_AI_API_KEY=
