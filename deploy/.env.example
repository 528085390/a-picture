# 复制为 .env 后填写；不要提交真实密钥
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# Cloudflare R2（S3 兼容）
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://img.example.com

# 腾讯云 COS（可选，file.storage.type=cos 时使用）
COS_HOST=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_NAME=
COS_REGION=

# 阿里云百炼（仅 AI 扩图需要）
ALIYUN_AI_API_KEY=
